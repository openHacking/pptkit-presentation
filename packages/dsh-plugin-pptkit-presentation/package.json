{
  "name": "dsh-plugin-pptkit-presentation",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "DeepSeek Harness plugin bundle that registers the pptkit-presentation Agent Skill (PPTKit deck authoring, preview, and PPTX export) with DSH's skill catalog.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openHacking/pptkit-presentation.git",
    "directory": "packages/dsh-plugin-pptkit-presentation"
  },
  "homepage": "https://github.com/openHacking/pptkit-presentation#readme",
  "bugs": {
    "url": "https://github.com/openHacking/pptkit-presentation/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "skill"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/sync-skill.mjs && tsc -p tsconfig.json",
    "prepare": "pnpm build",
    "prepack": "pnpm build",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
